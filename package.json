    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@fontsource-variable/quicksand": "^5.1.0",
    "@fontsource-variable/nunito-sans": "^5.1.0"
