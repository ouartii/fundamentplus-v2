Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# https en zonder www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Interne bestanden blokkeren
RewriteRule ^api/_ - [F,L]
RewriteRule ^private/ - [F,L]

# Oude URL's (WordPress) -> nieuwe pagina's
RewriteRule ^klachtenregeling/?$ /klachtenregelement/ [R=301,L]
RewriteRule ^woonbegeleiding/?$ /begeleid-wonen/ [R=301,L]
RewriteRule ^privacyverklaring/?$ /privacy/ [R=301,L]
RewriteRule ^(feed|comments/feed|wp-json)(/.*)?$ / [R=301,L]

# Trailing slash toevoegen voor pagina's
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /$1/ [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Testomgeving (2.fundamentplus.nl) niet laten indexeren
  <If "%{HTTP_HOST} =~ /^2\./">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
